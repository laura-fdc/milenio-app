# Clave para firmar las sesiones (genera una con: npx auth secret)
AUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs y servicios > Credenciales)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correos con permiso total (root), separados por comas
ROOT_EMAILS=

# Upstash Redis (Vercel las crea solas al añadir Upstash desde el Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Solo en local: login de prueba sin Google
# AUTH_DEV_LOGIN=1
